# Environment variable overrides — copy to .env and edit as needed.
# Do NOT commit .env to source control.

RABBITMQ_USER=guest
RABBITMQ_PASS=guest

# Ollama model names (must be pulled before use)
EMBED_MODEL=nomic-embed-text
LLM_MODEL=llama3.2

QUEUE_NAME=defects
PREFETCH_COUNT=1
METRICS_LOG_INTERVAL_SECONDS=30
DLX_EXCHANGE=defects.dlx
DLQ_NAME=defects.dlq

# Migration feature flags (Phase 0)
USE_LANGGRAPH_QUERY=false
USE_LANGGRAPH_SUMMARY=false
