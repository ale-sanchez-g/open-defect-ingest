# Environment variable overrides — copy to .env and edit as needed.
# Do NOT commit .env to source control.

RABBITMQ_USER=guest
RABBITMQ_PASS=guest

# Ollama model names (must be pulled before use)
EMBED_MODEL=nomic-embed-text
LLM_MODEL=llama3.2
OLLAMA_NUM_PARALLEL=1
OLLAMA_MAX_LOADED_MODELS=1
OLLAMA_KEEP_ALIVE=30m

QUEUE_NAME=defects
PREFETCH_COUNT=1
METRICS_LOG_INTERVAL_SECONDS=30
DLX_EXCHANGE=defects.dlx
DLQ_NAME=defects.dlq

# Migration feature flags (Phase 0)
USE_LANGGRAPH_QUERY=false
USE_LANGGRAPH_SUMMARY=false
GRAPH_TRACE_ENABLED=true
PROMPT_STRATEGY=local_versioned
PROMPTS_DIR=/app/prompts
OPM_BASE_URL=
OPM_TIMEOUT_SECONDS=5

# Datadog Observability
# Set DD_API_KEY to enable ingestion in your Datadog org.
DD_API_KEY=
DD_SITE=datadoghq.com
DD_ENV=local
DD_VERSION=1.0.0
DD_AGENT_HOST=datadog-agent
DD_TRACE_AGENT_PORT=8126
DD_DOGSTATSD_PORT=8125
DD_TRACE_ENABLED=true
DD_TRACE_LANGCHAIN_ENABLED=false
DD_LOGS_INJECTION=true
DD_RUNTIME_METRICS_ENABLED=true
DD_PROFILING_ENABLED=true
DD_TELEMETRY_ENABLED=true
DD_AI_TELEMETRY_ENABLED=true
DD_API_SERVICE=open-defect-api
DD_INGESTOR_SERVICE=open-defect-ingestor
DD_API_METRICS_NAMESPACE=open_defect_ingest.api
DD_INGESTOR_METRICS_NAMESPACE=open_defect_ingest.ingestor
